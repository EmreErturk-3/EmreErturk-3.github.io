---
import Base from '../../layouts/Base.astro';
const zebraSizes = [
  ['SFT, baseline', 57.81, 3.57, 0, 0, 35.32, 22.81],
  ['SFT, AC-3', 66.56, 9.64, 0.50, 0, 29.61, 14.28],
  ['GRPO bucketed, baseline', 54.69, 4.29, 0, 0, 36.38, 25.86],
  ['GRPO bucketed, AC-3', 42.50, 6.43, 0, 0, 35.59, 23.79],
  ['GRPO normalized, baseline', 60.94, 6.43, 0.50, 0, 37.89, 25.20],
  ['GRPO normalized, AC-3', 58.13, 3.57, 0.50, 0, 36.71, 25.28],
];
const zebraTable = [
  ['Base, baseline prompt', 15.62, 50.96, 0, 26.91],
  ['Base, AC-3 prompt', 18.75, 53.06, 0, 22.60],
  ['SFT, baseline prompt', 57.81, 80.22, 3.57, 47.07],
  ['SFT, AC-3 prompt', 66.56, 83.47, 9.64, 52.88],
  ['GRPO bucketed, baseline', 54.69, 81.80, 4.29, 49.40],
  ['GRPO bucketed, AC-3', 42.50, 71.62, 6.43, 50.06],
  ['GRPO normalized, baseline', 60.94, 83.16, 6.43, 50.42],
  ['GRPO normalized, AC-3', 58.13, 82.36, 3.57, 48.42],
];
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
 ['Generate', '<a href="https://arxiv.org/abs/2502.01100">ZebraLogic</a> released its 1,000 evaluation puzzles and described its generator in prose, but not the source. In-distribution training data was a prerequisite, so we reimplemented the pipeline. It covers all 25 sizes from 2×2 to 6×6 and 25 attribute categories. A weighted pool of clues is checked with the Z3 SMT solver for a unique solution, then clues are removed greedily while the solution stays unique, leaving a minimal set.'],
 ['Prompt', 'We compare two strategies. The baseline prompt comes from ZebraLogic and asks for free-form reasoning followed by a JSON solution. The AC-3 prompt writes the steps of the arc-consistency algorithm in natural language: start from domains, apply a clue, remove values with no valid partner, and propagate until a domain collapses.'],
 ['Fine-tune', 'We generated 1,000 training and 150 validation puzzles and collected DeepSeek-R1 traces under both prompts. Keeping only puzzles solved correctly under both left 937 training and 139 validation examples, each verified against the ground truth. <a href="https://huggingface.co/Qwen/Qwen2.5-3B-Instruct">Qwen2.5-3B-Instruct</a> was fine-tuned with LoRA (r = 64, α = 128) separately for each prompt.'],
 ['Reinforce', 'From the best SFT checkpoint of each prompt, we continued with GRPO on a separate set of 1,000 puzzles, using 16 rollouts per prompt and DAPO-style clipping. Puzzle accuracy alone gives almost no signal on hard puzzles, so the reward uses cell accuracy. We tested a bucketed reward (0, 0.33, 0.66, 1) and a normalized reward k/36, which gives solving k cells the same value at any puzzle size.'],
];
const finds = [
 ['Fine-tuning does most of the work.', 'SFT on 937 examples accounts for the overwhelming majority of the gains over the few-shot model. GRPO adds only marginal changes on top.'],
 ['A threshold appears at medium size.', 'The base model solves no medium puzzles under either prompt. After SFT it reaches 3.57% with the baseline prompt and 9.64% with AC-3, so training brings enough structured reasoning to occasionally finish a full solution.'],
 ['The best prompt depends on the training stage.', 'AC-3 is the strongest prompt under SFT, while GRPO improves the baseline prompt modestly and degrades AC-3. The rigid structure of AC-3 suits imitation. Its longer generations and higher parse error rates work against rollout-based exploration.'],
 ['Long structured reasoning breaks the output format.', 'SFT removes parse errors on small puzzles, but they return with size. On X-large puzzles the AC-3 SFT model reaches 101 parse errors against 38 for the baseline prompt.'],
 ['Part of the gain is specific to this format.', 'On the out-of-domain Enigmata-Eval benchmark, the best configuration (bucketed GRPO with the baseline prompt) reaches 8.00% and AC-3 GRPO variants fall to zero. Large and X-large puzzles also stay close to zero in puzzle accuracy.'],
];
---
<Base title="Smart Zebra" description="A prompt-to-GRPO recipe for logic-grid reasoning in small language models.">
<div class="wrap pagehead"><span class="tag work">Manuscript in revision</span><h1>Smart Zebra</h1><p class="lead">A Prompt-to-GRPO Recipe for Logic-Grid Reasoning in Small Language Models</p><p class="kicker" style="margin-top:12px">Onur Kansoy and Emre Ertürk, equal contribution · Advisor: <a href="https://selmatekir.github.io">Assoc. Prof. Selma Tekir</a> · B.Sc. thesis, <a href="https://en.iyte.edu.tr/">IZTECH</a> · Funded by <a href="https://tubitak.gov.tr/tr/burslar/lisans/burs-programlari/icerik-2209-a-universite-ogrencileri-arastirma-projeleri-destekleme-programi">TÜBİTAK 2209-A</a></p></div>
<div class="wrap grid2">
 <div class="prose rv"><h2 class="h2">The problem</h2><p>Zebra puzzles, also known as Einstein's puzzles, ask you to match M attributes to N houses from a set of text clues. They are NP-complete constraint satisfaction problems with one correct answer, which makes them a controlled and automatically verifiable test of logical reasoning. Their linguistic form also suits language models better than a grid puzzle such as Sudoku.</p><p>Current models struggle with them, and prior work mostly evaluates prompting or hands the puzzle to a formal solver. We asked a different question: how far can a small model get on its own with a complete training recipe, and can a classical algorithm improve how it reasons?</p><p>The same constraint-propagation idea runs through my <a href="../aeass/">AEASS</a> work: there, logic reduction prepares the search space for an evolutionary algorithm; here, AC-3 is written out in natural language as a reasoning procedure for a language model.</p>
 <div class="stats"><div><b>18.75%</b><span>base model, small puzzles, AC-3 prompt</span></div><div><b>66.56%</b><span>after SFT with the same prompt</span></div></div></div>
 <div class="rv"><ol class="clues" id="zc" aria-label="Puzzle clues"></ol><div class="arena"><canvas id="zb" style="width:100%;aspect-ratio:4/3" aria-label="Constraint propagation on a three-house puzzle"></canvas></div><div class="hudline" id="zh" style="min-height:38px"></div><div class="ctrl"><button id="zn" type="button">next step</button><button id="zr" type="button">restart</button></div><p class="note">The worked example from the AC-3 prompt in the paper's appendix.</p></div>
</div>
<div class="wrap section"><h2 class="h2 rv">The recipe</h2><ol class="recipe">{steps.map(([h,p])=><li class="rv"><h3>{h}</h3><p set:html={p}></p></li>)}</ol>
<figure class="rv zf"><img src={`${b}/media/research/zebra_reward.webp`} alt="Diagram of cell-accuracy rewards: model output compared to ground truth, and the normalized and bucketed reward functions" loading="lazy"><figcaption class="note">Cell-accuracy rewards. Two wrong names give puzzle accuracy 0 but cell accuracy 7/9, so the model still receives a useful signal.</figcaption></figure></div>
<div class="wrap section"><h2 class="h2 rv">Results on ZebraLogic</h2><div class="tw rv"><table class="tbl"><thead><tr><th>Configuration</th><th>Small puzzle %</th><th>Small cell %</th><th>Medium puzzle %</th><th>Medium cell %</th></tr></thead><tbody>{zebraTable.map(r=><tr class={r[0]==='SFT, AC-3 prompt'?'best':''}><td>{r[0]}</td><td>{(r[1] as number).toFixed(2)}</td><td>{(r[2] as number).toFixed(2)}</td><td>{(r[3] as number).toFixed(2)}</td><td>{(r[4] as number).toFixed(2)}</td></tr>)}</tbody></table></div>
<details class="rv zd"><summary class="mono">All four size categories</summary><div class="tw"><table class="tbl"><thead><tr><th>Configuration</th><th>Small puzzle %</th><th>Medium puzzle %</th><th>Large puzzle %</th><th>X-large puzzle %</th><th>Large cell %</th><th>X-large cell %</th></tr></thead><tbody>{zebraSizes.map(r=><tr>{r.map((v,i)=><td>{i?(v as number).toFixed(2):v}</td>)}</tr>)}</tbody></table></div></details></div>
<div class="wrap section"><h2 class="h2 rv">What we found</h2><div class="finds">{finds.map(([h,p])=><div class="rv"><h3>{h}</h3><p>{p}</p></div>)}</div></div>
<div class="wrap section"><hr class="rule"><div class="grid2" style="margin-top:26px"><div class="prose rv"><h2 class="h2">Contributions</h2><ul class="dl"><li>A reproducible reimplementation of the ZebraLogic puzzle generator.</li><li>An adaptation of the AC-3 algorithm into a reasoning prompt, compared with the baseline through the whole pipeline.</li><li>A staged SFT and GRPO recipe with cell-accuracy rewards, with measurable gains over the few-shot model.</li></ul></div>
<div class="prose rv"><h2 class="h2">Limits</h2><p>This work evaluates one model, Qwen2.5-3B-Instruct, trained on a single A100 on Google Colab. Generalisation across model families, scales and training budgets is still open. The interaction between prompt structure and GRPO needs deeper study, and the pipeline was built to allow that.</p><p>The manuscript is being revised for submission and is available on request.</p></div></div></div>
</Base>
<style is:global>
.dl{padding-left:18px;margin:0}.dl li{margin-block:6px}
.recipe{list-style:none;counter-reset:s;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.recipe li{counter-increment:s;background:var(--panel);border:2px solid var(--wall);padding:18px;min-width:0}.recipe h3{font-size:23px;margin-bottom:6px}.recipe h3::before{content:counter(s) ". ";color:var(--mut);font-weight:400}.recipe p{font-size:16px;line-height:1.5}
.clues{list-style:none;counter-reset:c;margin:0 0 12px;padding:0;display:grid;gap:6px}.clues li{counter-increment:c;display:grid;grid-template-columns:auto minmax(0,1fr);gap:9px;padding:7px 10px;border:1px solid var(--line);font-size:15px;line-height:1.4;transition:background .25s,border-color .25s}.clues li::before{content:"Clue " counter(c);font:12.5px/1.6 var(--mono);color:var(--mut);white-space:nowrap}.clues li.on{background:var(--panel);border-color:var(--seek);box-shadow:inset 3px 0 0 var(--seek)}
.zf{margin:20px 0 0}.zf img{width:100%;background:#fff;border:2px solid var(--wall)}.zd{margin-top:14px}.zd summary{cursor:pointer;font-size:14px;padding-block:6px}
.finds{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 36px}.finds h3{font-size:21px;margin-bottom:5px}.finds>div{min-width:0;border-top:1px solid var(--line);padding-top:10px}
@media(max-width:760px){.recipe,.finds{grid-template-columns:minmax(0,1fr)}}
</style>
<script>
import { ZEBRA, drawZebra, fit } from '../../scripts/sims';
document.addEventListener('astro:page-load',()=>{const c=document.getElementById('zb') as HTMLCanvasElement;if(!c)return;let f=fit(c),g=new Set<string>(),i=0;const h=document.getElementById('zh')!,zc=document.getElementById('zc')!;zc.innerHTML=ZEBRA.clues.map(x=>`<li>${x}</li>`).join('');
const d=()=>{drawZebra(f.g,f.W,f.H,g);h.textContent=i?ZEBRA.steps[i-1].say:'Every cell starts with all candidates. Press next step.';[...zc.children].forEach((l,k)=>l.classList.toggle('on',!!i&&ZEBRA.steps[i-1].clue===k+1))};new ResizeObserver(()=>{f=fit(c);d()}).observe(c);
document.getElementById('zn')!.onclick=()=>{if(i<ZEBRA.steps.length){ZEBRA.steps[i].rm.forEach(x=>g.add(x));i++;d()}};document.getElementById('zr')!.onclick=()=>{g=new Set();i=0;d()};d()});
</script>

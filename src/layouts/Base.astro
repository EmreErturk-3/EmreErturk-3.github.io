---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/500-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
const { title = 'Emre Ertürk', description = 'Emre Ertürk, Computer Engineering, İzmir Institute of Technology. Evolutionary computation, artificial life and robotics.' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [['Research & Projects','/research'],['Robotics','/robotics'],['About','/about']];
const CV = `${b}/docs/emre-erturk-cv.pdf`;
const full = title === 'Emre Ertürk' ? title : `${title} · Emre Ertürk`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{full}</title><meta name="description" content={description}>
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}><meta property="og:image" content={new URL(`${b}/media/emre.webp`, Astro.site)}><meta property="og:title" content={full}><meta property="og:description" content={description}><meta property="og:type" content="website">
<link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml"><link rel="icon" href={`${b}/favicon.png`} type="image/png" sizes="64x64"><link rel="apple-touch-icon" href={`${b}/favicon.png`}>
<script is:inline>(()=>{const f=()=>{try{const t=localStorage.getItem('site-theme');document.documentElement.dataset.theme=t==='dark'?'dark':'light'}catch(e){}};f();document.addEventListener('astro:after-swap',f)})();</script>
<ClientRouter />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="nav" transition:persist="nav"><div class="in">
 <a class="brand" href={`${b}/`}><svg class="glider" viewBox="0 0 3 3" aria-hidden="true"><path fill="currentColor" d="M1 0h1v1H1zM2 1h1v1H2zM0 2h3v1H0z" shape-rendering="crispEdges"/></svg>Emre Ertürk</a>
 <nav class="links" aria-label="Main">{nav.map(([n,h])=><a href={`${b}${h}/`} data-nav={h}>{n}</a>)}<a href={CV} target="_blank" rel="noopener" data-astro-reload>CV</a><a href={`${b}/docs/emre-erturk-transcript.pdf`} target="_blank" rel="noopener" data-astro-reload>Transcript</a></nav>
 <button class="theme" id="theme" type="button" aria-label="Switch between light and dark theme" title="Light or dark theme"><svg class="moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.7 14.7A9 9 0 0 1 9.3 3.3a9 9 0 1 0 11.4 11.4Z"/></svg><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/></svg></button>
 </div><div class="bar" id="bar"></div></header>
<main id="main"><slot /></main>
<footer class="foot"><div class="wrap in">
 <div class="mails"><a class="big" href="mailto:emreerturk@std.iyte.edu.tr">emreerturk@std.iyte.edu.tr</a><a class="mono" href="mailto:emreerturk4585@gmail.com">emreerturk4585@gmail.com</a></div>
 <div class="ls"><a href="https://github.com/EmreErturk-3">GitHub</a><a href={CV} target="_blank" rel="noopener" data-astro-reload>CV</a><a href={`${b}/transcript/`}>Transcript</a></div>
</div></footer>
<script src="../scripts/motion.ts"></script>
</body></html>
